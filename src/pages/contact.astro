---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Samuel Lippman">
  <main>
    <nav>
      <a href="/" class="back">← All Shoots</a>
    </nav>

    <header>
      <h1>Contact</h1>
      <p class="sub">Send me a message and I will get back to you.</p>
    </header>

    <form
      method="POST"
      action="https://formspree.io/f/mqejjyrl"
      class="contact-form"
    >
      <input type="hidden" name="_subject" value="New message from samuellippman.com" />
      <input type="hidden" name="_next" value="https://samuellippman.com/contact-success" />
      <input type="text" name="_gotcha" style="display:none" />

      <div class="field">
        <label for="email">Your email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="you@example.com"
          required
        />
      </div>

      <div class="field">
        <label for="phone">Phone number <span class="optional">(optional)</span></label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="555-555-5555"
        />
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          placeholder="What would you like to say?"
          required
        ></textarea>
      </div>

      <button type="submit" class="submit">Send Message</button>
    </form>
  </main>
</Layout>

<style>
  main {
    max-width: 600px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
  }

  nav { margin-bottom: 3rem; }

  .back {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    transition: color 0.2s;
  }

  .back:hover { color: var(--text); }

  header { margin-bottom: 2.75rem; }

  h1 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .sub {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.03em;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  label {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .optional {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.72rem;
    color: #555;
  }

  input,
  textarea {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: inherit;
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 3px;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: #444;
  }

  input:focus,
  textarea:focus {
    border-color: #444;
  }

  .submit {
    align-self: flex-start;
    background: var(--accent);
    color: #000;
    border: none;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.75rem 2rem;
    border-radius: 3px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .submit:hover { opacity: 0.85; }

  @media (max-width: 480px) {
    main { padding: 3.5rem 1rem 4rem; }
    .submit { width: 100%; text-align: center; }
  }
</style>
