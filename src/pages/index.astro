---
import Layout from '../layouts/Layout.astro';
import { readdirSync, statSync, existsSync } from 'fs';
import { join, extname } from 'path';
import { execFileSync } from 'child_process';

const PHOTO_EXTS = new Set(['.jpg', '.jpeg', '.png']);

function isPhoto(filename: string): boolean {
  return PHOTO_EXTS.has(extname(filename).toLowerCase());
}

const DATE_FOLDER_RE = /^(\d{2})-(\d{2})-(\d{2})$/;
const CAM_TIMESTAMP_RE = /^CAM_(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/;

// Earliest capture timestamp embedded in the drone's own filenames (CAM_YYYYMMDDHHMMSS_...).
// This is the most reliable date signal: it travels with the photo files themselves,
// so it survives folder renames and re-cloning the repo on any machine.
function getEarliestCamTimestamp(photoFiles: string[]): number | null {
  let earliest: number | null = null;
  for (const file of photoFiles) {
    const m = file.match(CAM_TIMESTAMP_RE);
    if (!m) continue;
    const [, yyyy, mm, dd, hh, mi, ss] = m;
    const t = new Date(Number(yyyy), Number(mm) - 1, Number(dd), Number(hh), Number(mi), Number(ss)).getTime();
    if (earliest === null || t < earliest) earliest = t;
  }
  return earliest;
}

// Newest-first. Preference order:
// 1. Earliest CAM_ timestamp embedded in the shoot's own photo filenames (most reliable).
// 2. Folder name, if it's still in MM-DD-YY format.
// 3. Shoot's earliest git commit date (survives re-cloning, unlike filesystem timestamps).
// 4. Filesystem birthtime, as a last resort for an uncommitted folder with no CAM_ photos.
function getSortTimestamp(slug: string, dirPath: string, photoFiles: string[]): number {
  const camTimestamp = getEarliestCamTimestamp(photoFiles);
  if (camTimestamp !== null) return camTimestamp;

  const dateMatch = slug.match(DATE_FOLDER_RE);
  if (dateMatch) {
    const [, mm, dd, yy] = dateMatch;
    return new Date(2000 + Number(yy), Number(mm) - 1, Number(dd)).getTime();
  }

  try {
    const output = execFileSync('git', ['log', '--format=%at', '--', `drone-photos/${slug}`], {
      cwd: process.cwd(),
      encoding: 'utf-8',
    }).trim();
    if (output) {
      const lines = output.split('\n');
      return Number(lines[lines.length - 1]) * 1000;
    }
  } catch {
    // not a git repo, git unavailable, or folder not yet committed — fall through
  }
  try {
    return statSync(dirPath).birthtimeMs;
  } catch {
    return 0;
  }
}

const droneDir = join(process.cwd(), 'public', 'drone-photos');

interface Shoot {
  slug: string;
  name: string;
  coverPhoto: string | null;
}

let shoots: Shoot[] = [];

if (existsSync(droneDir)) {
  const entries = readdirSync(droneDir);
  const shootFolders = entries.filter(e => {
    if (e.startsWith('.')) return false;
    try { return statSync(join(droneDir, e)).isDirectory(); } catch { return false; }
  });

  const withPhotos = shootFolders.map(slug => ({
    slug,
    files: readdirSync(join(droneDir, slug)).filter(isPhoto).sort(),
  }));

  withPhotos.sort((a, b) =>
    getSortTimestamp(b.slug, join(droneDir, b.slug), b.files) -
    getSortTimestamp(a.slug, join(droneDir, a.slug), a.files)
  );

  shoots = withPhotos.map(({ slug, files }) => {
    const cover = files.find(f => f.replace(/\.[^.]+$/, '').toLowerCase() === 'cover') ?? files[0];
    return {
      slug,
      name: slug,
      coverPhoto: cover ? `/drone-photos/${slug}/${cover}` : null,
    };
  });
}
---

<Layout title="Samuel Lippman — Drone Photography">
  <main>
    <header>
      <h1>Samuel Lippman</h1>
      <p class="tagline">Drone Photography</p>
    </header>

    {shoots.length === 0 ? (
      <p class="empty">No shoots yet.</p>
    ) : (
      <div class="grid">
        {shoots.map(shoot => (
          <a href={`/${shoot.slug}`} class="card">
            <div class="cover">
              {shoot.coverPhoto
                ? <img src={shoot.coverPhoto} alt={shoot.name} loading="lazy" />
                : <div class="no-photo" />
              }
            </div>
            <div class="card-info">
              <span class="card-date">{shoot.name}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
</Layout>

<style>
  main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 5rem;
  }

  header {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .tagline {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1px;
    background: var(--border);
  }

  .card {
    background: var(--bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card:hover .cover img {
    transform: scale(1.04);
  }

  .no-photo {
    width: 100%;
    height: 100%;
    background: var(--surface);
  }

  .card-info {
    padding: 0.85rem 1rem;
    background: var(--bg);
  }

  .card-date {
    font-size: 0.8rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .empty {
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    main { padding: 4.5rem 1rem 3rem; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
