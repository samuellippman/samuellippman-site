---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Drone photography by Samuel Lippman' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LJ3X3C4RS1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LJ3X3C4RS1');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0a0a0a;
        --surface: #141414;
        --border: #1e1e1e;
        --text: #e0e0e0;
        --muted: #777;
        --accent: #ffffff;
      }

      html {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      body { min-height: 100vh; }

      a { color: inherit; text-decoration: none; }

      img { display: block; width: 100%; height: 100%; object-fit: cover; }

      .site-nav {
        position: fixed;
        top: 3.25rem;
        right: 1.5rem;
        z-index: 200;
        display: flex;
        gap: 1.5rem;
      }

      .site-nav a {
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        transition: color 0.2s;
        padding: 0.35rem 0;
      }

      .site-nav a:hover,
      .site-nav a[data-active] {
        color: var(--accent);
      }

      .site-banner {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 300;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        text-align: center;
        padding: 0.5rem 1rem;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      @media (max-width: 480px) {
        .site-nav {
          gap: 1rem;
          right: 1rem;
          top: 2.9rem;
        }
        .site-nav a {
          padding: 0.5rem 0;
          font-size: 0.7rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="site-banner">More shoots coming soon!</div>
    <nav class="site-nav">
      <a href="/about" {...Astro.url.pathname === '/about' ? { 'data-active': '' } : {}}>About Me</a>
      <a href="/contact" {...Astro.url.pathname === '/contact' ? { 'data-active': '' } : {}}>Contact</a>
      <a href="https://www.instagram.com/samuel_lippman/" target="_blank" rel="noopener noreferrer">Instagram</a>
    </nav>
    <slot />
  </body>
</html>
